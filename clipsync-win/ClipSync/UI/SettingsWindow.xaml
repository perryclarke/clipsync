<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ClipSync.UI.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:ClipSync.UI"
    Title="ClipSync Settings">

    <!-- No Background here: the constructor applies Mica when the OS supports
         it, and only falls back to painting an opaque page brush when it does
         not. Setting one in XAML would hide the backdrop. -->
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- The window's content is extended into the title bar, so this strip
             stands in for it: SetTitleBar hands it to the system as the drag
             region, and the caption buttons draw over its right-hand end.
             Its Height and Padding are both overwritten in the constructor
             from the system title bar's real metrics; the values here are
             only what the designer shows. Centring the title in a strip
             taller than the caption buttons is what pushes it out of line
             with them. -->
        <Grid x:Name="TitleBarDrag" Grid.Row="0" Height="32" Padding="16,0,144,0">
            <!-- The bottom margin is an optical correction, not padding.
                 VerticalAlignment centres the line box, and Segoe UI's line
                 box carries more room above the cap height than below the
                 baseline, so a centred box leaves the letters low: measured
                 against the caption glyphs, the cap-height band sat 3
                 physical pixels below their centre. A centred element is
                 displaced by half its margin, so 4 lifts it by 2 effective
                 units. TextLineBounds="Tight" is the tidier-looking fix and
                 was tried first; it moved the text by nothing at all, and so
                 did trimming this to 3: at 150% the difference is inside a
                 pixel, and what is left is a pixel of residual, not error. -->
            <TextBlock Text="ClipSync Settings" VerticalAlignment="Center"
                       Margin="0,0,0,4"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Grid>

        <!-- Three fixed bands and one scrolling one. Only the list of apps
             scrolls; the group header and the add row stay put. A page-level
             ScrollViewer here instead meant that a third excluded app pushed
             the add row off the bottom of the window, so the way to add a
             fourth was to scroll looking for the button. -->
        <Grid Grid.Row="1" Padding="20,12,20,16" VerticalAlignment="Top">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Privacy"
                       Style="{StaticResource BodyStrongTextBlockStyle}"
                       Margin="0,0,0,8"
                       AutomationProperties.HeadingLevel="Level1"/>

            <!-- The header and the list are one closed group; the add row is
                 a separate card below it. Every divider in the group is drawn
                 by the element *below* it: the header has no bottom edge,
                 each row has a top edge, and the list itself closes the
                 bottom. Drawing them from both sides instead gives a two
                 pixel line everywhere two borders meet. -->
            <controls:SettingsCard Grid.Row="1" x:Name="GroupHeader"
                    Header="Excluded apps"
                    Description="Items copied while these apps are in the foreground are not sent to your other devices."
                    CornerRadius="4,4,0,0"
                    BorderThickness="1,1,1,0">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE72E;"/>
                </controls:SettingsCard.HeaderIcon>
            </controls:SettingsCard>

            <Grid Grid.Row="2">
                <!-- MaxHeight is set in code to two and a half rows, measured
                     from a realised row rather than assumed, so the half row
                     showing at the bottom is what tells you there is more
                     below. A whole number of rows looks like the whole list. -->
                <!-- The bottom edge here is what a half-shown row is clipped
                     against. Without it the cut row simply stopped, and ran
                     straight into the add row below with nothing between
                     them. -->
                <ListView x:Name="ExcludedList" SelectionMode="None"
                          Padding="0" Background="Transparent"
                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                          BorderThickness="1,0,1,1"
                          CornerRadius="0,0,4,4"
                          AutomationProperties.Name="Excluded apps"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <!-- The row is a SettingsCard and brings its own
                                 padding; the container must add none, or the
                                 rows stop lining up with the header above. -->
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="MinHeight" Value="0"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="ui:ExcludedAppRow">
                            <controls:SettingsCard Header="{x:Bind Name}"
                                                   HeaderIcon="{x:Bind HeaderIcon}"
                                                   Description="{x:Bind Detail}"
                                                   CornerRadius="0"
                                                   BorderThickness="0,1,0,0">
                                <Button Click="OnRemove"
                                        AutomationProperties.Name="{x:Bind RemoveLabel}"
                                        ToolTipService.ToolTip="{x:Bind RemoveLabel}">
                                    <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                                </Button>
                            </controls:SettingsCard>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Sits in the list's place when there is no list. An empty
                     bordered strip with nothing in it reads as a bug. -->
                <TextBlock x:Name="EmptyText" Visibility="Collapsed"
                           Margin="24,0" TextWrapping="Wrap" TextAlignment="Center"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="No apps excluded. Everything you copy is synced."/>
            </Grid>

            <!-- The action lives after the list, the way "Add a device" does
                 in Windows Settings. A card of its own with a gap above it,
                 rather than the last row of the group: when the list is
                 scrolled the row above this is cut in half, and a shared
                 edge there made the add row look like the bottom of that
                 half-row instead of a separate thing. -->
            <!-- A Border rather than a SettingsCard, unlike the rows above.
                 SettingsCard sized itself from its header alone here, which
                 with only one line of text came out shorter than its own
                 button needed, so the button overflowed the padded content
                 area downward and sat 13px below the card's centre. Neither
                 MinHeight nor VerticalContentAlignment moved it: the control
                 lays its content out from its template, and the template is
                 compiled into the toolkit where it cannot be adjusted from
                 here. A label beside a button does not need the control's
                 semantics, so this draws the same card by hand and centres
                 both. Metrics are matched to the rows deliberately: 68 high,
                 16 in from the edge. -->
            <Border Grid.Row="3" Margin="0,8,0,0" MinHeight="68" Padding="16,0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="4">
              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Add an app to this list"
                           VerticalAlignment="Center" TextWrapping="Wrap"/>

                <!-- Two ways in, one control: picking from the installed list
                     is the obvious path, but it keys an app on its Start Menu
                     shortcut target, which for launcher-based apps is not the
                     executable that owns the foreground window. Capture is
                     the escape hatch for those. -->
                <DropDownButton Grid.Column="1" x:Name="AddButton" Content="Add app"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Add app to the excluded list">
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <MenuFlyoutItem Text="Choose an installed app…" Click="OnAddApp">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE71D;"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="CaptureItem"
                                            Text="Exclude the app I switch to…"
                                            Click="OnCaptureCurrentApp">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE890;"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
              </Grid>
            </Border>
        </Grid>

        <InfoBar Grid.Row="2" x:Name="CaptureStatus"
                 Margin="20,0,20,16" IsOpen="False" IsClosable="True"/>
    </Grid>
</Window>
