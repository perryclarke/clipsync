<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ClipSync.UI.TrayPopup"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="ClipSync">
    <Border Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
            BorderBrush="{ThemeResource SystemControlForegroundBaseMediumLowBrush}"
            BorderThickness="1" CornerRadius="8" Padding="16">
        <StackPanel Spacing="8" MinWidth="240">
            <TextBlock Text="ClipSync" FontWeight="SemiBold" FontSize="16"/>
            <TextBlock x:Name="DidText" FontSize="11" FontFamily="Consolas"
                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
            <MenuFlyoutSeparator/>
            <StackPanel x:Name="PeerList" Spacing="4"/>
            <TextBlock x:Name="EmptyText" Text="Looking for peers on the local network..."
                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                       FontSize="13"/>
            <MenuFlyoutSeparator/>
            <Button Content="Quit" Click="OnQuit" HorizontalAlignment="Stretch"/>
        </StackPanel>
    </Border>
</Window>
