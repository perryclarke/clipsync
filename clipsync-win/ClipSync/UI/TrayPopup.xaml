<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ClipSync.UI.TrayPopup"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="ClipSync">
    <Border Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
            BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
            BorderThickness="1" CornerRadius="8" Padding="16">
        <StackPanel Spacing="8" MinWidth="240">
            <!-- The title carries the global state: a paused device should
                 say so without the user having to read the button. -->
            <TextBlock x:Name="TitleText" Text="ClipSync" FontWeight="SemiBold" FontSize="16"/>
            <TextBlock x:Name="DidText" FontSize="11" FontFamily="Consolas"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <MenuFlyoutSeparator/>
            <StackPanel x:Name="PeerList" Spacing="4"/>
            <TextBlock x:Name="EmptyText" Text="Looking for peers on the local network..."
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       FontSize="13"/>
            <MenuFlyoutSeparator/>
            <!-- AutomationProperties.Name on every button below: a Button
                 whose Content is a Panel rather than a string exposes no
                 accessible name of its own, so without these the tray menu
                 reads as a row of unnamed buttons. -->
            <Button Click="OnSettings" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    AutomationProperties.Name="Settings">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon Glyph="&#xE713;" FontSize="14"/>
                    <TextBlock Text="Settings…"/>
                </StackPanel>
            </Button>
            <!-- Between Settings and Quit. Pauses sending only: items from
                 peers still arrive while this is on. -->
            <Button x:Name="PauseButton" Click="OnTogglePause"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon x:Name="PauseGlyph" Glyph="&#xE769;" FontSize="14"/>
                    <TextBlock x:Name="PauseLabel" Text="Pause syncing"/>
                </StackPanel>
            </Button>
            <Button Click="OnQuit" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    AutomationProperties.Name="Quit">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon Glyph="&#xE7E8;" FontSize="14"/>
                    <TextBlock Text="Quit"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Border>
</Window>
