<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ClipSync.UI.TrayPopup"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="ClipSync">
    <Border x:Name="Root"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
            BorderThickness="1" CornerRadius="8" Padding="12">
        <StackPanel Spacing="10" MinWidth="288">

            <!-- Title and identity share a line, the way a Windows 11 flyout
                 header does. The title carries the global pause state, so a
                 paused device says so without the user having to read down to
                 the button; it trims rather than pushing the identity off the
                 right edge. -->
            <Grid Margin="4,2,4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TitleText" Text="ClipSync"
                           Style="{StaticResource BodyStrongTextBlockStyle}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="DidText" Grid.Column="1" Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           FontFamily="Consolas"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </Grid>

            <!-- Peers are data, so they sit in a card group like the settings
                 window's excluded list. The rows are built in code; each one
                 after the first draws its own top divider. -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="4">
                <Grid>
                    <StackPanel x:Name="PeerList"/>
                    <TextBlock x:Name="EmptyText"
                               Text="Looking for peers on the local network…"
                               Margin="12,14" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </Grid>
            </Border>

            <!-- Commands stay buttons rather than card rows: they act rather
                 than describe, and a real Button keeps its focus, hover and
                 contrast-theme behaviour without being restyled into
                 something that only looks clickable.

                 AutomationProperties.Name on each: a Button whose Content is
                 a Panel rather than a string exposes no accessible name of
                 its own, so without these the menu reads as unnamed buttons. -->
            <StackPanel Spacing="4">
                <Button Click="OnSettings" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left" Padding="12,8"
                        AutomationProperties.Name="Settings">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE713;" FontSize="15"/>
                        <TextBlock Text="Settings…" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <!-- Between Settings and Quit. Pauses sending only: items from
                     peers still arrive while this is on. -->
                <Button x:Name="PauseButton" Click="OnTogglePause"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left" Padding="12,8">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon x:Name="PauseGlyph" Glyph="&#xE769;" FontSize="15"/>
                        <TextBlock x:Name="PauseLabel" Text="Pause syncing"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Click="OnQuit" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left" Padding="12,8"
                        AutomationProperties.Name="Quit">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE7E8;" FontSize="15"/>
                        <TextBlock Text="Quit" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
