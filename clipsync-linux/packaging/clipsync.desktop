[Desktop Entry]
Type=Application
Name=ClipSync
Comment=LAN-only encrypted clipboard sync
Exec=/opt/clipsync/clipsync
Icon=edit-copy
Terminal=false
Categories=Utility;
# Autostart only: the entry exists to start the daemon at login, not to
# be launched by hand. The window is opened from the tray icon.
NoDisplay=true
X-GNOME-Autostart-enabled=true
